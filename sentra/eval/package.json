  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20",
    "eslint": "^9.39.4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  }
