NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Where POST /entries goes. Unset, it goes to the route handler in
# src/app/api/entries/ (the Vercel deployment); set, it goes to FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side only — used by the route handler to write a submission to
# Supabase (src/lib/server/supabaseWriter.ts). The service-role key bypasses
# RLS: never prefix it with NEXT_PUBLIC_ and never import it into a client
# component. Unset, the handler still computes and returns, but writes nothing
# and reports supabase_sync.status = "skipped".
# Dashboard > Settings > API > service_role key.
#
# Because RLS is bypassed, the route establishes the caller itself: requireUser
# for the owner, then a participants lookup through that user's own RLS-scoped
# client. No identity is ever read from the request body.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# デモモード。ログインを省き、固定データ（src/lib/blesc/fixtures.ts）で
# すべての画面を確認できる。next dev では既定で有効なので設定は不要。
# デプロイ先でもデモを見せたいときだけ 1 にする。
# 有効でも Supabase には一切アクセスしないため、生徒のデータは表示されない。
# NEXT_PUBLIC_DEMO_MODE=1

# ---------------------------------------------------------------------------
# 研究パイロット（#131 #163）。すべて未設定なら、その機能が「無効」になる。
# 設定漏れの失敗方向は常に「収集しない・発行できない」であって、
# 「無防備に収集する」ではない。
# ---------------------------------------------------------------------------

# 保存する日記原文の暗号化キー（AES-256-GCM、base64 で**ちょうど** 32 バイト）。
# 未設定なら原文は一切保存されない（src/lib/server/rawTextCrypto.ts）。
# `-base64` であって `-hex` ではない。hex の64文字は base64 としても読めてしまい
# 48バイトにデコードされるので、鍵としては拒否される（#255）。
#   openssl rand -base64 32
RESEARCH_RAW_TEXT_KEY=

# 新規の研究本文は最長90日。1〜90日の整数のみ。より長い値は90日に制限。
# 期限の設定だけで削除は完了しない。purgeの定期実行・監視・既存行の移行が必要。
RESEARCH_RAW_TEXT_RETENTION_DAYS=90

# 研究エクスポートを実行できる auth.users.id のカンマ区切り。
# 空 = 誰も実行できない。ロールではなく明示列挙なのは、
# 「いつのまにかその権限に入っていた」を起こさないため。
RESEARCH_EXPORT_USER_IDS=

# 仮名 → データベース上の身元 の対応表を引ける auth.users.id のカンマ区切り。
# 空 = 誰も引けない。RESEARCH_EXPORT_USER_IDS とは別の変数にしてあるのは、
# データを取り出せる人と、仮名を解ける人を分けるため（#167）。
# 両方に同じ id を書けば分離は無くなる。意図してそうするとき以外は分けること。
RESEARCH_IDENTITY_MAP_USER_IDS=

# 招待コードの HMAC 鍵（base64 で 32 バイト以上）。
# DB にはこの鍵で計算したハッシュだけが入り、コード本体はどこにも残らない。
# 未設定なら、どのコードも引き換えできない。
# 本番と dry run で別の鍵にすると、dry run のコードは本番で使えなくなる。
#   openssl rand -base64 32
PILOT_INVITE_HMAC_KEY=

# 招待コードの発行・失効と、保護者確認リンクの発行ができる auth.users.id の
# カンマ区切り。空 = 誰もできない。範囲外のアカウントには 404 を返す。
# 保護者確認リンクは参加者本人には決して返らず、この一覧の人だけが受け取って
# 学校の連絡経路で保護者に届ける（#164）。
PILOT_OPERATOR_USER_IDS=

# 保護者確認トークンの HMAC 鍵（base64 で 32 バイト以上、#164）。
# 招待コードとは別の鍵にする。片方が漏れてももう片方を偽造できず、
# 保護者側だけを鍵交換で無効化できる。未設定なら確認リンクを発行できず、
# 発行済みのリンクも受け付けない（＝ 未成年は誰も enrolled に進めない）。
#   openssl rand -base64 32
PILOT_GUARDIAN_HMAC_KEY=

# 保護者確認リンクと危機通知のリンクを組み立てるためのオリジン。
# Host ヘッダは攻撃者が指定できるので使わない。
#
# 未設定のときの振る舞いは経路ごとに違う（#202）:
#   - 保護者確認リンク: パスだけを返す。参加者が自分の端末を渡す前提なら動く。
#   - 危機通知: リンクの行ごと省く。Slack やメールの本文に相対パスを置いても
#     解決先が無く、しかも送信は成功して delivered として記録されてしまうため。
#
# **ビルド時にも設定すること。** NEXT_PUBLIC_ はビルド時にバンドルへ焼き込まれる
# ので、稼働中のデプロイに後から足しても、再ビルドするまで反映されない。
NEXT_PUBLIC_SITE_URL=https://pilot.example.jp

# このデプロイが収集する研究の slug（pilot_studies.slug）。
# 設定されたときだけ、/journal と POST /api/entries に参加登録ゲートがかかる
# （src/lib/server/pilotGate.ts）。通常のデプロイでは未設定にしておく。
#
# **ビルド時にも設定すること。** 未設定のままビルドすると /journal が静的に
# 事前レンダリングされ、レイアウトのゲートが実行されない。Vercel の
# Environment Variables は build と runtime の両方に入るので、通常は
# 設定するだけでよい。POST 側のゲートは実行時に必ず動く。
PILOT_STUDY_SLUG=

# ---------------------------------------------------------------------------
# 危機の通知。未設定なら「誰にも届かない」が、握りつぶされることはない —
# 通知は safety_escalations に status='pending'、last_error='no delivery
# channel configured' のまま残り、/api/safety/dispatch の GET が
# channels=false と owed の件数を返す。
#
# 設定前に起きた危機も失われない。pending のままキューに残るので、
# 下のいずれかを設定した後の dispatch で実際に送信される。再送回数
# （上限6回）も消費しない。設定漏れは「遅れる」であって「届かない」ではない。
#
# status='no_recipient' は別の意味で、こちらは終端（再送しない）。チャネルは
# 設定済みだが、見守り同意が有効な教員が一人もいない、という状態を指す。
# last_error は 'no recipient with active oversight consent'。
# 詳細は sentra/docs/crisis_escalation.md（#178）。
# ---------------------------------------------------------------------------

# 学校側の受け口（Slack / Teams / 当直の通知ゲートウェイなど）。
# POST {"text": "..."} を受けられれば何でもよい。個人宛てではないので、
# 「今夜は誰が当番か」を知っている学校側の仕組みに渡すのがこの経路の役割。
SAFETY_ALERT_WEBHOOK_URL=

# メール経路。両方そろって初めて有効になる。送信は Resend の HTTP API を
# 直接叩いており、npm 依存は増やしていない（安全経路の下に依存ツリーを
# 置かないため）。宛先は見守り同意が有効な教員のみで、実行時に再計算する。
RESEND_API_KEY=
SAFETY_ALERT_EMAIL_FROM=

# 送信に失敗した通知を拾い直す /api/safety/dispatch の共有シークレット。
# 未設定ならこのエンドポイントは全拒否する（誰でも叩ける再送は、
# このデプロイに好きなときにメールを送らせる手段になるため）。
#   openssl rand -base64 32
SAFETY_DISPATCH_TOKEN=

# elevated（明確な危険表明のない不調）でも通知するか。既定は crisis のみ。
# elevated は頻度が高く、毎晩鳴らすと受け取る側が無視を学習するので、
# 学校が明示的に選んだときだけ有効にする。
SAFETY_ALERT_ON_ELEVATED=

# 通知ログの recipient_hash に使う HMAC 鍵（base64 で32バイト以上、#189）。
# この列は「誰に送ったかを、アドレスそのものを残さずに記録する」ために存在する。
# 以前は無鍵の SHA-256 だったため、教職員名簿を持つ者が候補を総当たりすれば
# 一致するダイジェストがすぐ見つかり、仮名化として成立していなかった。
# 未設定なら hash は null になるだけで、危機通知そのものは止めない。
#   openssl rand -base64 32
SAFETY_RECIPIENT_HASH_KEY=

# Vercel Cron が /api/cron/* を叩くときの共有シークレット（#179 #185）。
# 未設定ならすべての定期実行が 403 で拒否される = 保持期限の purge も
# 危機通知の再送も走らない。デプロイ時に必ず設定すること。
#   openssl rand -base64 32
CRON_SECRET=

# 1 のとき、このデプロイは専用の研究デプロイとして振る舞う。
# デモモードのURL上書きを一切受け付けず、/demo-view も 404 になる（#193）。
# **ビルド時にも設定すること** — /demo-view の遮断は next.config.ts の
# rewrites で行うため、ビルド時の値で決まる。
NEXT_PUBLIC_PILOT_MODE=

# 危機通知が誰にも届かなかったことを運用者へ知らせる受け口（#178）。
# **SAFETY_ALERT_WEBHOOK_URL とは別のURLにすること。** 報告する内容が
# 「配信経路が配信できなかった」なので、同じ経路で送ると、最も必要なときに
# 火元の回路につながった火災報知器になる。参加者を特定する情報は送らない。
SAFETY_OPS_ALERT_WEBHOOK_URL=

# 試行回数の上限（#234）。未設定なら既定値。詳細は
# docs/pilot/infrastructure-runbook.md §5.6
PILOT_INVITE_CHECK_LIMIT=
PILOT_INVITE_REDEEM_LIMIT=
PILOT_GUARDIAN_ISSUE_LIMIT=
EXTERNAL_MODEL_LIMIT=

# ---------------------------------------------------------------------------
# 規約・プライバシーポリシーの施行。両方そろって初めて「施行済み」になる。
# ---------------------------------------------------------------------------

# 施行する版。`LEGAL_ENACTED_VERSION` と完全一致しなければ施行されない
# （"true" や "1" では通らない — 施行は決裁であって、フラグではないため）。
NEXT_PUBLIC_LEGAL_ENACTED=

# 施行日（YYYY-MM-DD、日本時間）。版だけ・日付だけでは施行されない。
# 未設定のあいだ /legal は「（案）・未施行」と表示し、
# POST /api/legal/acceptance は 409 で同意の記録を拒否する。
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
