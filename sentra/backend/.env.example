# Copy to .env (or .env.local, which is loaded first) and fill in.

# ── Supabase sync ────────────────────────────────────────────────────────────
# With SUPABASE_URL set, each submission is computed against SQLite and then
# mirrored into Supabase, which is what the UI reads. Leave both unset for
# local work: the submission still computes and persists, it just isn't
# mirrored, and /api/entries reports supabase_sync.status = "skipped".
#
# The service-role key bypasses RLS — that is what allows this process to write
# rows on behalf of a signed-in user. It is a server-side secret: never expose
# it to the browser, and never prefix it with NEXT_PUBLIC_.
# Dashboard > Settings > API > service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Model access ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# "true" bypasses the provider entirely and uses the mock extractor.
USE_MOCK_LLM=false
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ── Local storage and CORS ───────────────────────────────────────────────────
# Defaults to sentra.db next to this file when unset.
DATABASE_URL=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
