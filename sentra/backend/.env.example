# Copy to .env (or .env.local, which is loaded first) and fill in.

# ── Supabase sync ────────────────────────────────────────────────────────────
# With SUPABASE_URL set, each submission is computed against SQLite and then
# mirrored into Supabase, which is what the UI reads. Leave both unset for
# local work: the submission still computes and persists, it just isn't
# mirrored, and /api/entries reports supabase_sync.status = "skipped".
#
# The service-role key bypasses RLS — that is what allows this process to write
# rows on behalf of a signed-in user. It is a server-side secret: never expose
# it to the browser, and never prefix it with NEXT_PUBLIC_.
# Dashboard > Settings > API > service_role key.
#
# Because RLS is bypassed, /api/entries must establish the caller itself. It
# does so in supabase_writer.resolve_identity: the owner comes from the request's
# Bearer access token, verified against Supabase Auth, and the participant is
# looked up under that owner. No identity is ever read from the request body.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── 認証（#259） ──────────────────────────────────────────────────────────────
# 参加者のデータを扱うエンドポイントは、Supabase の access token を要求する。
# 上の2つが未設定だと**誰も検証できない**ので、それらは 503 を返して何も出さない。
# 検証の中身は resolve_identity と同じで、トークンの持ち主が名指しされた
# participant code を所有しているかを見る。
#
# 下を "1" にすると、その検証を丸ごと止める。ローカル開発と `pytest` のための
# もので、Supabase プロジェクトが無い環境でこのサービスを動かすときだけ使う。
# **実際の日記が入っている配備では絶対に設定しないこと。** 設定されている間、
# GET /api/health は authentication: "disabled" と答える。
BLESC_ALLOW_UNAUTHENTICATED_API=

# ── Model access ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# "true" bypasses the provider entirely and uses the mock extractor.
USE_MOCK_LLM=false
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-audio-preview

# ── Local storage and CORS ───────────────────────────────────────────────────
# Defaults to sentra.db next to this file when unset.
DATABASE_URL=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
